profiles {
    conda {
        conda.enabled          = true
        conda.useMamba         = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    docker {
        docker.enabled         = true
        docker.sudo            = false
        docker.runOptions      = "-u \$(id -u):\$(id -g) --platform=linux/amd64"
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    vm {
        workDir            = getWorkDir()
        conda.cacheDir     = getCondaCacheDir()
        process {
            errorStrategy  = "terminate"
            maxRetries     = 0
            resourceLimits = [ cpus: 24, memory: 96.GB, time: 72.h ]
        }
    }
    chimera {
        workDir            = getWorkDir()
        conda.cacheDir     = getCondaCacheDir()
        executor.queueSize = 30
        process {
            executor       = "slurm"
            queue          = "cpu_batch"
            errorStrategy  = "retry"  // "terminate"
            maxRetries     = 1
            resourceLimits = [ cpus: 24, memory: 800.GB, time: 72.h ]
        }
    }
    gcp {
        workDir            = "gs://arc-ctc-nextflow/scRecounter/prod/work"
        fusion.enabled     = false
        wave.enabled       = false
        executor {
            queueSize      = 200
            pollInterval   = "15 sec"
        }
        params {
            barcodes       = "data/gcp/barcodes.csv"
            star_indices   = "data/gcp/star_indices.csv"
            provider       = "gcp"
            gcp_project_id = "c-tc-429521"
        }
        process {
            executor       = "google-batch"
            errorStrategy  = "retry"
            maxRetries     = 2
            scratch        = true
            resourceLimits = [ cpus: 36, memory: 700.GB, time: 120.h ]
        }
        google {
            project   = "c-tc-429521"
            location  = "us-east1"
            batch {
                serviceAccountEmail = "nick-nextflow@c-tc-429521.iam.gserviceaccount.com"
                spot                = true
                maxSpotAttempts     = 3
                bootDiskSize        = 150.GB
            }
            storage {
                multiplier = 2.0
            }
        }
    }
    dev {
        params {
            min_read_len = 26
            db_name      = "sragent-test"
        }
    }
    gcp_dev {
        workDir = "gs://arc-ctc-nextflow/scRecounter/dev/work/"
    }
    acc_dev {
        params {
            accessions   = "data/accessions_small_n2.csv"
            output_dir   = "gs://arc-ctc-nextflow/scRecounter/dev/results/acc-n2"
            use_database = false
        }
    }
    acc_dev_problems {
        params {
            accessions   = "data/accessions_problems.csv"
            output_dir   = "gs://arc-ctc-nextflow/scRecounter/dev/results/acc-problems"
            use_database = false
        }
    }
    acc_dev_rat {
        params {
            organisms    = "Rattus norvegicus"
            accessions   = "data/accessions_rat_n2.csv"
            output_dir   = "/scratch/multiomics/nickyoungblut/scRecounter/acc-rat"
            use_database = false
        }
    }
    acc_other_org {
        params {
            accessions   = "data/accessions_other-org.csv"
            star_indices = "data/star_indices.csv"
            output_dir   = "/scratch/multiomics/nickyoungblut/scRecounter/acc_other-org"
            use_database = false
        }
    }
    no_acc_dev {
        params {
            accessions = ""
            output_dir = "/scratch/multiomics/nickyoungblut/scRecounter/no-acc"
        }
    }
    gcp_no_acc_dev {
        params {
            accessions = ""
            output_dir = "gs://arc-ctc-nextflow/scRecounter/dev/results/no-acc"
        }
    }
    other_org {
        params {
            organisms = "Rattus norvegicus,Macaca mulatta,Callithrix jacchus,Equus caballus,Canis lupus,Bos taurus,Ovis aries,Sus scrofa,Oryctolagus cuniculus,Heterocephalus glaber,Pan troglodytes,Gorilla gorilla,Felis catus,Pan paniscus,Chlorocebus aethiops,Monodelphis domestica,Capra hircus,Vicugna pacos,Chinchilla lanigera,Cavia porcellus,Mesocricetus auratus,Erinaceus europaeus,Neovison vison,Ornithorhynchus anatinus,Mustela putorius,Tupaia belangeri,Gallus gallus,Taeniopygia guttata,Anser cygnoides,Anas platyrhynchos,Trachemys scripta,Xenopus tropicalis,Ambystoma mexicanum,Danio rerio,Salmo salar,Gasterosteus aculeatus,Drosophila melanogaster,Caenorhabditis elegans,Anopheles gambiae,Schistosoma mansoni,Arabidopsis thaliana,Oryza sativa,Solanum lycopersicum,Zea mays,Saccharomyces cerevisiae"
        }
    }
    report {
        report {
            enabled   = true
            overwrite = true
            file      = "${params.output_dir}/nf-report/${params.timestamp}.html"
        }
    }
    trace {
        trace {
            enabled   = true
            overwrite = true
            file      = "${params.output_dir}/nf-trace/${params.timestamp}.txt"
            fields    = "task_id,hash,native_id,name,status,exit,submit,container,cpus,time,disk,memory,attempt,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir,scratch"
        }
    }
}


